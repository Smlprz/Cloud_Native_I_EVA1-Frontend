# Configuracion publica del frontend (no contiene secretos: son identificadores).
# CRA incorpora estas variables al compilar: si cambian, hay que volver a compilar.

# URL del API Gateway con el stage, sin barra final.
REACT_APP_API_BASE=https://dgejdk6tg5.execute-api.us-east-1.amazonaws.com/prod

# Microsoft Entra ID. Una sola app (pedidos360-api) hace de SPA y de API.
REACT_APP_AZURE_TENANT_ID=e5372bf0-c5e3-4286-887c-79069f209c1f
REACT_APP_AZURE_CLIENT_ID=ce3e5b61-0b01-4a67-a42b-f15ccb364024

# Opcional: scopes separados por espacios. Por defecto se piden productos, carrito, ordenes y resenas.
# REACT_APP_AZURE_API_SCOPES=

# Opcional: enlace al panel web de RabbitMQ (solo lo ve el ADMIN en la pantalla de RabbitMQ).
REACT_APP_RABBIT_PANEL_URL=http://34.235.89.235:15672
