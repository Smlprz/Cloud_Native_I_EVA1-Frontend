# Copia este archivo a .env y completa los valores.

# === Backend ===
# Opcion A - via AWS API Gateway (incluye stage + ruta del recurso):
REACT_APP_PRODUCTOS_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/productos
REACT_APP_CARRITO_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/carrito
REACT_APP_AUTH_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/auth
# Opcion B - local, directo a los microservicios:
#   REACT_APP_PRODUCTOS_URL=http://localhost:8081/api/productos
#   REACT_APP_CARRITO_URL=http://localhost:8082/api/carrito
#   REACT_APP_AUTH_URL=http://localhost:8083/api/auth

# === Azure AD / Microsoft Entra ID (ver docs/AZURE-AD-SETUP.md) ===
REACT_APP_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_AZURE_TENANT_ID=11111111-1111-1111-1111-111111111111
REACT_APP_AZURE_API_SCOPES=api://00000000-0000-0000-0000-000000000000/productos.read api://00000000-0000-0000-0000-000000000000/carrito.read api://00000000-0000-0000-0000-000000000000/carrito.write
